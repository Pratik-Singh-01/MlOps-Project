        "textMode": "auto"
      },
      "title": "Fraud Prediction Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "(fraud_predictions_total / http_requests_total{handler=\"/predict\"}) * 100",
          "legendFormat": "Fraud Rate %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
